{
  "name": "pi-open-code-review",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Feasibility spike: native OpenCodeReview using a pi 1.6.0 model",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "22.18.0",
    "typescript": "5.9.3"
  }
}
