{
  "name": "pi-native-open-code-review",
  "version": "0.2.6",
  "type": "module",
  "description": "Review Git changes with Alibaba OpenCodeReview and your pi model. Read line-level findings in the conversation or review them in a TUI panel.",
  "license": "MIT",
  "author": "Meowooh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meowooh/pi-open-code-review.git"
  },
  "homepage": "https://github.com/Meowooh/pi-open-code-review#readme",
  "bugs": {
    "url": "https://github.com/Meowooh/pi-open-code-review/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "open-code-review",
    "code-review"
  ],
  "files": [
    "src/**/*.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "typebox": "1.3.27"
  }
}
